# dependencies
node_modules/
.pnpm-store/

# builds
dist/
build/
.next/
out/
next-env.d.ts
*.tsbuildinfo

# turbo
.turbo/

# env
.env
.env.*
!.env.example

# local docker overrides
docker-compose.override.yml

# prisma generated client
generated/

# meeting file uploads (MEETING_FILES_DIR default, created by the API at boot)
apps/api/storage/

# tests & coverage
coverage/
# playwright run output (apps/web e2e)
apps/web/test-results/
apps/web/playwright-report/

# logs
*.log
npm-debug.log*
pnpm-debug.log*

# editors & os
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json

# agent tooling state
# Playwright MCP writes snapshots, console logs, and screenshots here as it drives the app.
# The server is declared in .mcp.json, so this appears for everyone; it is run output, and
# oxfmt fails format:check on it if it is left tracked.
.playwright-mcp/
.omc/
.agents/*
# shared agent skills are checked in; the rest of .agents/ is local state
!.agents/skills/
# ui-ux-pro-max is installed once at ~/.claude/skills and linked in here, so it is useful in
# every project and its 2.7 MB of CSV data stays out of the repo. The link points at an
# absolute home path, which is machine-local and must not be committed.
.agents/skills/ui-ux-pro-max
skills-lock.json
