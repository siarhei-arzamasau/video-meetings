{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "Nest.js",
  "extends": "./base.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "strictPropertyInitialization": false,
    "declaration": false,
    "removeComments": true,
    "sourceMap": true,
    "outDir": "./dist",
    // Deliberately no "incremental": nest-cli's deleteOutDir wipes dist/ while a stale
    // .tsbuildinfo still claims those files were emitted, so tsc silently skips them and
    // the app starts with a half-populated dist/.
    "incremental": false
  }
}
