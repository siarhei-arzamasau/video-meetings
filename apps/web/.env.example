# `pnpm dev` from the repository root rewrites the port here to wherever the API actually
# landed, but only while this stays a local URL matching apps/api's PORT. Point it at another
# host and it is left alone.
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# Dev server port preference, read by the root `pnpm dev`. `next dev` on its own defaults to
# 3000 unless WEB_PORT is exported — this file is loaded by Next, which is too late to pick one.
WEB_PORT=3000
