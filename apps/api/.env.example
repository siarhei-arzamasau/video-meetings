NODE_ENV=development

# A preference: `pnpm dev` from the repository root moves up to the next free port when this
# one is taken. Running the API on its own honours it exactly, and fails if it is busy.
PORT=3001
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/video_meetings

# Signs access tokens. At least 32 characters; generate with `openssl rand -base64 32`.
JWT_SECRET=dev-only-replace-with-openssl-rand-base64-32
JWT_EXPIRES_IN_SECONDS=3600

# Root of meeting file storage, relative to apps/api. Created at boot and gitignored.
MEETING_FILES_DIR=storage
# Whether this process runs the file processing worker. One replica is enough; the e2e
# suite turns it off and drives the worker by hand.
MEETING_FILES_WORKER_ENABLED=true
# How long a claimed file stays with one worker before another may retry it.
MEETING_FILES_LEASE_SECONDS=60
# How long the worker sleeps after finding nothing to do.
MEETING_FILES_POLL_MS=1000
# How long a chunked upload session stays open before it 404s and its chunks are removed.
MEETING_FILE_UPLOAD_TTL_HOURS=24
# Whether the pipeline transcribes audio and video. Off by default. Changing it is a restart,
# and the URL below must be set whenever it is on.
MEETING_FILES_TRANSCRIPTION_ENABLED=false
# An OpenAI-compatible audio/transcriptions endpoint (hosted, or a self-hosted Whisper
# server). Required when the flag above is on; the API refuses to boot otherwise.
TRANSCRIPTION_API_URL=
# Sent as a bearer token when set. Leave empty for an endpoint that needs no credential.
TRANSCRIPTION_API_KEY=
# The `model` field of the request. Hosted endpoints require one; self-hosted Whisper
# servers ignore it.
TRANSCRIPTION_MODEL=whisper-1
# How long one transcription may take before it is aborted and the file fails.
TRANSCRIPTION_TIMEOUT_SECONDS=600
