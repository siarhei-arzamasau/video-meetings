NODE_ENV=development

# A preference: `pnpm dev` from the repository root moves up to the next free port when this
# one is taken. Running the API on its own honours it exactly, and fails if it is busy.
PORT=3001
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/video_meetings

# Signs access tokens. Left empty on purpose: a placeholder here is a signing key published in
# this repository, and one long enough to pass validation is one the API would accept. Fill it
# in before the API will boot — `openssl rand -base64 32`, at least 32 characters.
JWT_SECRET=
JWT_EXPIRES_IN_SECONDS=3600

# The meeting tools' MCP server (`node dist/meeting-tools-stdio.main.js <meeting-id>`) is a
# process of its own that reads DATABASE_URL and JWT_SECRET from this file, and one variable
# that does not belong in it: MEETING_TOOLS_ACCESS_TOKEN, the access token of the user it
# answers for. That is a user's credential with an hour to live — the MCP client's
# configuration hands it over in the environment, and it is never read from this file.

# Credential attempts one client address may spend per window on /api/auth — register, login,
# and the password change. /api/auth/me is exempt; page gating calls it constantly.
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
AUTH_RATE_LIMIT_ATTEMPTS=10
# Reverse proxies you control in front of the API — which address a request is counted as. 0
# trusts none and ignores X-Forwarded-For; behind a proxy that terminates TLS, set exactly how
# many there are. One too many lets a client choose its own address, and so its own budget.
TRUST_PROXY_HOPS=0
# Browser origins allowed to call the API, comma-separated: scheme, host and port, no path.
# Required when NODE_ENV=production. Empty in development means the web app on WEB_PORT — at
# localhost and 127.0.0.1, 3000 unless `pnpm dev` moved it — which is what `pnpm dev` runs.
CORS_ORIGINS=

# Root of uploaded-file storage, relative to apps/api. Created at boot and gitignored.
# Meeting files and user avatars both live under it, each in their own subtree; avatars need
# no variable of their own, and the cap and accepted types for them are in @repo/shared.
MEETING_FILES_DIR=storage
# Whether this process runs the file processing worker. One replica is enough; the e2e
# suite turns it off and drives the worker by hand.
MEETING_FILES_WORKER_ENABLED=true
# How long a claimed file stays with one worker before another may retry it.
MEETING_FILES_LEASE_SECONDS=60
# How long the worker sleeps after finding nothing to do.
MEETING_FILES_POLL_MS=1000
# How long one `files/events` stream stays open before it closes and the client reconnects.
# At least 30 seconds.
MEETING_FILES_STREAM_TTL_SECONDS=300
# How long a chunked upload session stays open before it 404s and its chunks are removed.
MEETING_FILE_UPLOAD_TTL_HOURS=24
# Whether audio and video uploads are queued for transcription once they are ready. Off by
# default. Changing it is a restart, and the URL below must be set whenever it is on. Turning
# it on needs a Whisper server to be running: `docker compose --profile transcription up -d
# whisper` from the repository root. Turning it off again stops new transcriptions and keeps
# every status and transcript already stored.
MEETING_FILES_TRANSCRIPTION_ENABLED=false
# An OpenAI-compatible audio/transcriptions endpoint. This one is the `whisper` Compose service
# as this machine reaches it; change the port here if WHISPER_PORT in the root .env moved it.
# Boot checks the shape of the URL, never the server: with Whisper stopped the API still
# starts and serves uploads, and only the transcriptions fail.
TRANSCRIPTION_API_URL=http://localhost:8000/v1/audio/transcriptions
# Sent as a bearer token when set. Leave empty: the local Whisper service needs no credential.
TRANSCRIPTION_API_KEY=
# The `model` field of the request: Whisper `small`, under the name the `whisper` service
# preloads it by. The service answers 404 for a model it has not downloaded. Required whenever
# the flag above is on, and there is no default: the API refuses to boot without it.
TRANSCRIPTION_MODEL=Systran/faster-whisper-small
# How long one transcription may take before it is aborted and marked failed with a reason
# naming this limit; the file itself stays ready and downloadable. Twelve minutes: a one-hour
# recording at twice the measured rate — `small` on the Compose service took 5.3 to
# 6.0 seconds per minute of audio on an 18-core Apple Silicon laptop (2026-10-07). Raise it on
# a slower host, or for recordings much longer than an hour.
TRANSCRIPTION_TIMEOUT_SECONDS=720

# Whether a meeting gets a digest — summary, action items, decisions — written by Claude from
# the transcripts of its recordings. Off by default, because ON SENDS TRANSCRIPT TEXT TO
# ANTHROPIC: what was said in every transcribed recording of a meeting, and with it the
# meeting's id (a random UUID) and the titles of the tasks already recorded for that meeting,
# which Claude looks up so as not to record one twice. Nothing else — no recording, file name,
# email address, user id, or storage path. Changing it is a restart, and the token below
# must be set whenever it is on. A new transcript also needs transcription switched on above.
# THE RESTART THAT TURNS IT ON CATCHES UP: every meeting that already has transcribed
# recordings and no current digest is sent too, one paid request each, with nobody asking.
# Turning it off again sends nothing more and keeps every digest already stored.
MEETING_DIGEST_ENABLED=false
# How long one generation may take before it is hung up on and the digest marked failed with a
# reason naming this limit. Four minutes: twice the slowest generation the measurements predict
# (src/config/meeting-digest.defaults.ts); a typical digest takes three to twenty seconds.
MEETING_DIGEST_TIMEOUT_SECONDS=240
# How many times one generation may call its tools (find a task, write one, revise the
# summary) before every further call is refused and the model is told to answer. The digest is
# still written; tasks past the budget are not. A task is two calls, a search and a write, so
# 20 is ten tasks a generation and 2 is the least allowed. The model is told the number and
# records its most important tasks first. Each round of calls reads the transcripts again, so
# this is also what bounds the cost of a generation that keeps calling.
MEETING_DIGEST_MAX_TOOL_CALLS=20
# What the Claude Agent SDK authenticates with, and what every digest is paid from. Required
# whenever MEETING_DIGEST_ENABLED is on: the API refuses to boot without it. With the digest
# off, leave it empty and the API still boots. `test:live` needs a working one.
ANTHROPIC_AUTH_TOKEN=
