// Schema for @repo/api.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
  runtime      = "nodejs"
}

// Prisma 7 removed `url` from this block. The CLI reads the connection string from
// prisma.config.ts; the runtime client gets it through a driver adapter (PrismaService).
datasource db {
  provider = "postgresql"
}

/// A person who can host or join meetings. Mirrors the `User` shape in @repo/shared,
/// minus `passwordHash`, which never leaves this layer.
model User {
  id String @id @default(uuid()) @db.Uuid

  /// Stored normalised — trimmed and lowercased — so uniqueness is case-insensitive
  /// and a login cannot miss an account over capitalisation. Normalising in the DTO
  /// rather than here is what makes that constraint meaningful.
  email String @unique

  /// argon2id. Never bcrypt: bcrypt truncates at 72 bytes, which silently makes every
  /// password sharing a 72-byte prefix the same credential.
  passwordHash String @map("password_hash")

  displayName String @map("display_name")

  /// The avatar object's key under the storage root, or null for a user who has none.
  /// Nullable because every row that predates avatars has to stay valid, and because
  /// removing an avatar is exactly "set this back to null".
  avatarKey String? @map("avatar_key")

  /// Bumped on every avatar write, including removal. The browser fetches the image with a
  /// bearer token into a blob rather than through an `<img src>`, so nothing about the URL
  /// changes when the image does; this number is what tells a client to fetch again.
  avatarVersion Int @default(0) @map("avatar_version")

  // Timestamptz, not timestamp: `timestamp` comes back from the driver as a local-time
  // Date, so any comparison against a real instant is wrong by the machine's offset.
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  hostedMeetings         Meeting[]                 @relation("MeetingHost")
  meetingParticipations  MeetingParticipant[]
  uploadedFiles          MeetingFile[]
  fileUploads            MeetingFileUpload[]
  ownedDigestActionItems MeetingDigestActionItem[] @relation("MeetingDigestActionItemOwner")
  ownedTasks             Task[]                    @relation("TaskOwner")

  @@map("users")
}

enum MeetingStatus {
  scheduled
  live
  ended

  @@map("meeting_status")
}

model Meeting {
  id String @id @default(uuid()) @db.Uuid

  title       String
  status      MeetingStatus @default(scheduled)
  hostId      String        @map("host_id") @db.Uuid
  scheduledAt DateTime      @map("scheduled_at") @db.Timestamptz(3)

  host         User                 @relation("MeetingHost", fields: [hostId], references: [id], onDelete: Restrict)
  participants MeetingParticipant[]
  files        MeetingFile[]
  fileUploads  MeetingFileUpload[]
  digest       MeetingDigest?       @relation("MeetingDigestMeeting")
  tasks        Task[]               @relation("TaskSourceMeeting")

  @@index([hostId])
  @@map("meetings")
}

model MeetingParticipant {
  meetingId String @map("meeting_id") @db.Uuid
  userId    String @map("user_id") @db.Uuid

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([meetingId, userId])
  @@index([userId])
  @@map("meeting_participants")
}

enum MeetingFileStatus {
  uploaded
  processing
  ready
  failed
  deleted

  @@map("meeting_file_status")
}

/// Where a recording's transcription stands — a status of its own, beside the file's. A row
/// with none is not a recording, or reached `ready` while transcription was switched off.
///
/// UPPER_CASE here (`.claude/rules/prisma.md`) and lower-case on the wire, like
/// `MEETING_FILE_STATUSES`; `meeting-file.mapper.ts` is the one place that translates.
enum MeetingFileTranscriptionStatus {
  QUEUED
  TRANSCRIBING
  TRANSCRIBED
  FAILED

  @@map("meeting_file_transcription_status")
}

/// A file attached to a meeting. Mirrors `MeetingFile` in @repo/shared plus the columns the
/// two workers own (`storageKey`, `checksum`, `attempts`, `leasedUntil`, `purgedAt`, and the
/// transcription claim's count and lease), which never leave this layer.
model MeetingFile {
  id         String @id @default(uuid()) @db.Uuid
  meetingId  String @map("meeting_id") @db.Uuid
  uploaderId String @map("uploader_id") @db.Uuid

  /// The user's filename after trimming. Display only — the object lives at `storageKey`.
  name        String
  contentType String @map("content_type")
  /// Int, not BigInt: the cap is 100 MB. Past 2 GB this column changes in the same commit.
  size        Int
  /// `<meetingId>/<fileId>` under MEETING_FILES_DIR. Opaque, so a name can never be a path.
  storageKey  String @unique @map("storage_key")

  checksum      String?
  thumbnailKey  String? @map("thumbnail_key")
  /// `<storageKey>.transcript.txt`, set by the write that makes the transcription
  /// `TRANSCRIBED` and by nothing else. Null for a row in any other transcription status.
  transcriptKey String? @map("transcript_key")

  status        MeetingFileStatus @default(uploaded)
  /// User-safe copy only; the real cause is logged, never stored.
  failureReason String?           @map("failure_reason")
  /// Claims, not failures: incremented every time a worker takes the row.
  attempts      Int               @default(0)
  leasedUntil   DateTime?         @map("leased_until") @db.Timestamptz(3)

  /// Null until the file reaches `ready` as an audio or video file with transcription on:
  /// that one write sets `QUEUED`. Switching the setting off afterwards leaves it as it is.
  transcriptionStatus        MeetingFileTranscriptionStatus? @map("transcription_status")
  /// User-safe copy only, and only while the status is `FAILED`; the cause is logged.
  transcriptionFailureReason String?                         @map("transcription_failure_reason")
  /// Claims of the transcription, counted apart from `attempts`: the purge counts its own
  /// claims on that column and a delete resets it, so the two cannot share one.
  transcriptionAttempts      Int                             @default(0) @map("transcription_attempts")
  /// The transcription claim's lease, apart from `leasedUntil` for the same reason.
  transcriptionLeasedUntil   DateTime?                       @map("transcription_leased_until") @db.Timestamptz(3)

  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  processedAt DateTime? @map("processed_at") @db.Timestamptz(3)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(3)
  /// Set once the worker has removed the bytes of a soft-deleted row, so the purge runs
  /// exactly once and a crash mid-unlink is retried rather than forgotten.
  purgedAt    DateTime? @map("purged_at") @db.Timestamptz(3)

  // Restrict on both: nothing deletes a meeting or a user from under a file without going
  // through the worker's soft-delete-then-purge path.
  meeting  Meeting @relation(fields: [meetingId], references: [id], onDelete: Restrict)
  uploader User    @relation(fields: [uploaderId], references: [id], onDelete: Restrict)

  digestSources MeetingDigestSource[] @relation("MeetingDigestSourceFile")

  @@index([meetingId, status])
  @@index([status, leasedUntil])
  /// The transcription claim: queued rows, and transcribing ones whose lease has lapsed.
  @@index([transcriptionStatus, transcriptionLeasedUntil])
  @@map("meeting_files")
}

/// A chunked upload in progress: the bytes of a large file arriving one chunk at a time,
/// before any `MeetingFile` exists. Its own table precisely so that it is not one — no file
/// is listed, downloadable, or counted against the meeting's cap until `complete` assembles
/// the chunks and hands them to the single-request upload command.
///
/// Chunks live at `uploads/<id>/<index>` under MEETING_FILES_DIR and are removed by the
/// worker, which claims expired, unpurged rows the same way it claims a deleted file.
model MeetingFileUpload {
  id         String @id @default(uuid()) @db.Uuid
  meetingId  String @map("meeting_id") @db.Uuid
  uploaderId String @map("uploader_id") @db.Uuid

  /// The declared display name, already through `normaliseFileName`. The type is not declared
  /// at all: it is sniffed from the assembled bytes at completion, never taken from a client.
  name String
  /// Int, like `MeetingFile.size`, and capped at 1 GiB for the same reason.
  size Int

  chunkSize      Int   @map("chunk_size")
  chunkCount     Int   @map("chunk_count")
  /// Indexes durably on disk. A resend of the same index leaves one entry, so this is a set
  /// the handler keeps sorted rather than an append log.
  receivedChunks Int[] @map("received_chunks")

  /// Claims, not failures, and the purge lease: the same pair `meeting_files` carries, so a
  /// worker that dies mid-removal leaves a row another worker reclaims when the lease lapses,
  /// and a removal that keeps throwing is given up on instead of retried for ever.
  attempts    Int       @default(0)
  leasedUntil DateTime? @map("leased_until") @db.Timestamptz(3)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  /// When the session stops accepting chunks. Aborting sets this to now(); the worker treats
  /// expired and aborted identically, which is why abort needs no status column.
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  /// Set once the chunk tree is gone, so the removal runs exactly once and a crash mid-removal
  /// is retried rather than forgotten.
  purgedAt  DateTime? @map("purged_at") @db.Timestamptz(3)

  // Restrict on both, as for a file: nothing deletes a meeting or a user out from under an
  // upload whose chunks are still on disk.
  meeting  Meeting @relation(fields: [meetingId], references: [id], onDelete: Restrict)
  uploader User    @relation(fields: [uploaderId], references: [id], onDelete: Restrict)

  @@index([meetingId])
  /// The uploader's foreign key, and the per-uploader cap's count of unpurged sessions.
  @@index([uploaderId, purgedAt])
  @@index([expiresAt, purgedAt])
  @@map("meeting_file_uploads")
}

/// Where the latest generation of a meeting's digest stands. Stored UPPER_CASE
/// (`.claude/rules/prisma.md`) and lower-case on the wire, as `MEETING_DIGEST_STATUSES`;
/// `meeting-digest.mapper.ts` is the one place that translates.
enum MeetingDigestStatus {
  QUEUED
  GENERATING
  READY
  FAILED

  @@map("meeting_digest_status")
}

/// The digest of a meeting — summary, action items, decisions — written by Claude from the
/// transcripts of its recordings, and the state of the generation that writes it. One row per
/// meeting, made by the first request for a generation; a meeting nobody asked a digest for
/// has none.
///
/// The status and the content are separate things on purpose: `status` is where the *latest*
/// generation stands, the summary and the three child tables are what the last *successful*
/// one stored. A second generation that fails leaves the first one's content where it was.
model MeetingDigest {
  id        String @id @default(uuid()) @db.Uuid
  meetingId String @unique @map("meeting_id") @db.Uuid

  /// Null for a meeting that has a row and no digest: its last transcribed recording was
  /// deleted, or a recording its digest was built from was while nothing is generated. The
  /// row stays, because `version` has to keep rising for the clients that saw it.
  status            MeetingDigestStatus?
  /// User-safe copy only, and only while the status is `FAILED`; the cause is logged.
  failureReason     String?              @map("failure_reason")
  /// Claims, not failures: incremented every time a worker takes the row, and back to 0 with
  /// every generation that is asked for afresh.
  attempts          Int                  @default(0)
  leasedUntil       DateTime?            @map("leased_until") @db.Timestamptz(3)
  /// Bumped by every request for a generation. A claim remembers the value it took, and the
  /// write that ends it is final only if this has not moved meanwhile — otherwise the row
  /// goes back to `QUEUED`. That is all of "never two at once, and one more after a change".
  requestedRevision Int                  @default(0) @map("requested_revision")
  /// Bumped by every write that changes what a client is shown. A client keeps the higher of
  /// two, which orders an event against a fetch. A lease renewal changes nothing shown.
  version           Int                  @default(0)

  /// Null until a generation has succeeded. Bounded by the answer's guard, not the column.
  summary     String?
  /// When the stored content was generated; null exactly when `summary` is.
  generatedAt DateTime? @map("generated_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  /// Defaulted as well as `@updatedAt`: the request and the claim are raw SQL, which Prisma's
  /// client-side `@updatedAt` never sees, so they set it themselves and an insert needs one.
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  // Cascade, unlike a file: a digest holds no bytes on disk, so nothing has to outlive the
  // meeting in order to be cleaned up.
  meeting     Meeting                   @relation("MeetingDigestMeeting", fields: [meetingId], references: [id], onDelete: Cascade)
  actionItems MeetingDigestActionItem[] @relation("MeetingDigestActionItemDigest")
  decisions   MeetingDigestDecision[]   @relation("MeetingDigestDecisionDigest")
  sources     MeetingDigestSource[]     @relation("MeetingDigestSourceDigest")

  /// The foreign key's index, as the rules ask for one by this name. `@unique` above is the
  /// constraint — one digest per meeting, and what the request's `ON CONFLICT` names.
  @@index([meetingId])
  /// The claim: queued rows, and generating ones whose lease has lapsed.
  @@index([status, leasedUntil])
  @@map("meeting_digests")
}

/// One thing the meeting said has to be done. Replaced whole, with the decisions and the
/// sources, by every generation that succeeds.
model MeetingDigestActionItem {
  id       String @id @default(uuid()) @db.Uuid
  digestId String @map("digest_id") @db.Uuid

  /// The order Claude gave the items in, which is the order they are shown in.
  position    Int
  description String
  /// The owner as the transcripts named them, or null when they named nobody.
  ownerName   String? @map("owner_name")
  /// The host or participant that name was matched to, when it identifies exactly one. Null
  /// for a name that matched nobody, or more than one — and for every name of a digest whose
  /// members could not be read. Decided by the API from the meeting's members, never by the
  /// model.
  ownerId     String? @map("owner_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  digest MeetingDigest @relation("MeetingDigestActionItemDigest", fields: [digestId], references: [id], onDelete: Cascade)
  // SetNull: an item whose owner's account is gone is still an item, under the spoken name.
  owner  User?         @relation("MeetingDigestActionItemOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  @@index([digestId])
  @@index([ownerId])
  @@map("meeting_digest_action_items")
}

/// One thing the meeting decided.
model MeetingDigestDecision {
  id       String @id @default(uuid()) @db.Uuid
  digestId String @map("digest_id") @db.Uuid

  position    Int
  description String

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  digest MeetingDigest @relation("MeetingDigestDecisionDigest", fields: [digestId], references: [id], onDelete: Cascade)

  @@index([digestId])
  @@map("meeting_digest_decisions")
}

/// A recording whose transcript the stored content was generated from. What the read compares
/// with the recordings transcribed now: content is returned only while every source is still
/// one of them, and is out of date when one of them is not a source.
model MeetingDigestSource {
  id            String @id @default(uuid()) @db.Uuid
  digestId      String @map("digest_id") @db.Uuid
  meetingFileId String @map("meeting_file_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  digest MeetingDigest @relation("MeetingDigestSourceDigest", fields: [digestId], references: [id], onDelete: Cascade)
  // Restrict, as everything that references a file is: a file is soft-deleted and purged,
  // never removed, so this never fires — and the day a row is removed it should say so.
  file   MeetingFile   @relation("MeetingDigestSourceFile", fields: [meetingFileId], references: [id], onDelete: Restrict)

  @@unique([digestId, meetingFileId])
  @@index([digestId])
  @@index([meetingFileId])
  @@map("meeting_digest_sources")
}

/// Where a task stands. UPPER_CASE (`.claude/rules/prisma.md`). Two values on purpose: adding
/// one to a Postgres enum is a one-line migration, and taking one away is not.
enum TaskStatus {
  OPEN
  DONE

  @@map("task_status")
}

/// One thing to be done that came out of a meeting, as a record of its own — unlike a
/// `MeetingDigestActionItem`, which every successful generation replaces whole and which
/// therefore cannot carry a status from one generation to the next.
model Task {
  id              String  @id @default(uuid()) @db.Uuid
  /// As the caller gave it. With `sourceMeetingId` and `ownerId` it is the task's identity —
  /// what `TaskService.upsert` finds an existing task by — so a reworded title is another task.
  title           String
  sourceMeetingId String  @map("source_meeting_id") @db.Uuid
  /// Whose task it is: the user an MCP client wrote it as, and the only one whose client
  /// then changes it. Null for a task nobody owns, which is the meeting's and every member's
  /// to read — one a digest's generation wrote, or one older than this column. Not an
  /// assignee: nothing says who is to do the task.
  ownerId         String? @map("owner_id") @db.Uuid

  status TaskStatus @default(OPEN)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  /// Defaulted as well as `@updatedAt`: the upsert is raw SQL, which Prisma's client-side
  /// `@updatedAt` never sees, so it sets the column itself and an insert needs a value.
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  // Cascade, as for a digest: a task holds nothing on disk that has to outlive the meeting.
  sourceMeeting Meeting @relation("TaskSourceMeeting", fields: [sourceMeetingId], references: [id], onDelete: Cascade)
  // Cascade as well: a user's tasks are nobody else's to read, so they go with the account.
  // `SetNull` would hand them to nobody, and fail the delete wherever the meeting already
  // has a task nobody owns under the same title.
  owner         User?   @relation("TaskOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  /// One task per title for each owner within a meeting, and what the upsert's `ON CONFLICT`
  /// names. **`NULLS NOT DISTINCT` in the database**, written into the migration by hand
  /// because Prisma has no word for it: without it two tasks nobody owns never conflict, and
  /// every upsert of one inserts another.
  @@unique([sourceMeetingId, ownerId, title])
  /// The foreign keys' indexes, as the rules ask for one each.
  @@index([sourceMeetingId])
  @@index([ownerId])
  /// Trigrams of the title, for `TaskService.search`. Needs the `pg_trgm` extension, which
  /// the migration creates by hand: Prisma does not manage extensions here.
  @@index([title(ops: raw("gin_trgm_ops"))], type: Gin)
  @@map("tasks")
}
