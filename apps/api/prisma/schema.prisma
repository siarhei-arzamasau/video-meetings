// Schema for @repo/api.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
  runtime      = "nodejs"
}

// Prisma 7 removed `url` from this block. The CLI reads the connection string from
// prisma.config.ts; the runtime client gets it through a driver adapter (PrismaService).
datasource db {
  provider = "postgresql"
}

/// A person who can host or join meetings. Mirrors the `User` shape in @repo/shared,
/// minus `passwordHash`, which never leaves this layer.
model User {
  id String @id @default(uuid()) @db.Uuid

  /// Stored normalised — trimmed and lowercased — so uniqueness is case-insensitive
  /// and a login cannot miss an account over capitalisation. Normalising in the DTO
  /// rather than here is what makes that constraint meaningful.
  email String @unique

  /// argon2id. Never bcrypt: bcrypt truncates at 72 bytes, which silently makes every
  /// password sharing a 72-byte prefix the same credential.
  passwordHash String @map("password_hash")

  displayName String @map("display_name")

  // Timestamptz, not timestamp: `timestamp` comes back from the driver as a local-time
  // Date, so any comparison against a real instant is wrong by the machine's offset.
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  hostedMeetings        Meeting[]            @relation("MeetingHost")
  meetingParticipations MeetingParticipant[]
  uploadedFiles         MeetingFile[]

  @@map("users")
}

enum MeetingStatus {
  scheduled
  live
  ended

  @@map("meeting_status")
}

model Meeting {
  id String @id @default(uuid()) @db.Uuid

  title       String
  status      MeetingStatus @default(scheduled)
  hostId      String        @map("host_id") @db.Uuid
  scheduledAt DateTime      @map("scheduled_at") @db.Timestamptz(3)

  host         User                 @relation("MeetingHost", fields: [hostId], references: [id], onDelete: Restrict)
  participants MeetingParticipant[]
  files        MeetingFile[]

  @@index([hostId])
  @@map("meetings")
}

model MeetingParticipant {
  meetingId String @map("meeting_id") @db.Uuid
  userId    String @map("user_id") @db.Uuid

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([meetingId, userId])
  @@index([userId])
  @@map("meeting_participants")
}

enum MeetingFileStatus {
  uploaded
  processing
  ready
  failed
  deleted

  @@map("meeting_file_status")
}

/// A file attached to a meeting. Mirrors `MeetingFile` in @repo/shared plus the columns the
/// processing worker owns (`storageKey`, `checksum`, `attempts`, `leasedUntil`, `purgedAt`),
/// which never leave this layer.
model MeetingFile {
  id         String @id @default(uuid()) @db.Uuid
  meetingId  String @map("meeting_id") @db.Uuid
  uploaderId String @map("uploader_id") @db.Uuid

  /// The user's filename after trimming. Display only — the object lives at `storageKey`.
  name        String
  contentType String @map("content_type")
  /// Int, not BigInt: the cap is 100 MB. Past 2 GB this column changes in the same commit.
  size        Int
  /// `<meetingId>/<fileId>` under MEETING_FILES_DIR. Opaque, so a name can never be a path.
  storageKey  String @unique @map("storage_key")

  checksum     String?
  thumbnailKey String? @map("thumbnail_key")

  status        MeetingFileStatus @default(uploaded)
  /// User-safe copy only; the real cause is logged, never stored.
  failureReason String?           @map("failure_reason")
  /// Claims, not failures: incremented every time a worker takes the row.
  attempts      Int               @default(0)
  leasedUntil   DateTime?         @map("leased_until") @db.Timestamptz(3)

  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  processedAt DateTime? @map("processed_at") @db.Timestamptz(3)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(3)
  /// Set once the worker has removed the bytes of a soft-deleted row, so the purge runs
  /// exactly once and a crash mid-unlink is retried rather than forgotten.
  purgedAt    DateTime? @map("purged_at") @db.Timestamptz(3)

  // Restrict on both: nothing deletes a meeting or a user from under a file without going
  // through the worker's soft-delete-then-purge path.
  meeting  Meeting @relation(fields: [meetingId], references: [id], onDelete: Restrict)
  uploader User    @relation(fields: [uploaderId], references: [id], onDelete: Restrict)

  @@index([meetingId, status])
  @@index([status, leasedUntil])
  @@map("meeting_files")
}
