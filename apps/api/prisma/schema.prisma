// Schema for @repo/api.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
  runtime      = "nodejs"
}

// Prisma 7 removed `url` from this block. The CLI reads the connection string from
// prisma.config.ts; the runtime client gets it through a driver adapter (PrismaService).
datasource db {
  provider = "postgresql"
}

/// A person who can host or join meetings. Mirrors the `User` shape in @repo/shared,
/// minus `passwordHash`, which never leaves this layer.
model User {
  id String @id @default(uuid()) @db.Uuid

  /// Stored normalised — trimmed and lowercased — so uniqueness is case-insensitive
  /// and a login cannot miss an account over capitalisation. Normalising in the DTO
  /// rather than here is what makes that constraint meaningful.
  email String @unique

  /// argon2id. Never bcrypt: bcrypt truncates at 72 bytes, which silently makes every
  /// password sharing a 72-byte prefix the same credential.
  passwordHash String @map("password_hash")

  displayName String @map("display_name")

  // Timestamptz, not timestamp: `timestamp` comes back from the driver as a local-time
  // Date, so any comparison against a real instant is wrong by the machine's offset.
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@map("users")
}
