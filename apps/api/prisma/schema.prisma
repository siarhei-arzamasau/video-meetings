// Schema for @repo/api.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
  runtime      = "nodejs"
}

// Prisma 7 removed `url` from this block. The CLI reads the connection string from
// prisma.config.ts; the runtime client gets it through a driver adapter (PrismaService).
datasource db {
  provider = "postgresql"
}

/// A person who can host or join meetings. Mirrors the `User` shape in @repo/shared,
/// minus `passwordHash`, which never leaves this layer.
model User {
  id String @id @default(uuid()) @db.Uuid

  /// Stored normalised — trimmed and lowercased — so uniqueness is case-insensitive
  /// and a login cannot miss an account over capitalisation. Normalising in the DTO
  /// rather than here is what makes that constraint meaningful.
  email String @unique

  /// argon2id. Never bcrypt: bcrypt truncates at 72 bytes, which silently makes every
  /// password sharing a 72-byte prefix the same credential.
  passwordHash String @map("password_hash")

  displayName String @map("display_name")

  /// The avatar object's key under the storage root, or null for a user who has none.
  /// Nullable because every row that predates avatars has to stay valid, and because
  /// removing an avatar is exactly "set this back to null".
  avatarKey String? @map("avatar_key")

  /// Bumped on every avatar write, including removal. The browser fetches the image with a
  /// bearer token into a blob rather than through an `<img src>`, so nothing about the URL
  /// changes when the image does; this number is what tells a client to fetch again.
  avatarVersion Int @default(0) @map("avatar_version")

  // Timestamptz, not timestamp: `timestamp` comes back from the driver as a local-time
  // Date, so any comparison against a real instant is wrong by the machine's offset.
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  hostedMeetings        Meeting[]            @relation("MeetingHost")
  meetingParticipations MeetingParticipant[]
  uploadedFiles         MeetingFile[]
  fileUploads           MeetingFileUpload[]

  @@map("users")
}

enum MeetingStatus {
  scheduled
  live
  ended

  @@map("meeting_status")
}

model Meeting {
  id String @id @default(uuid()) @db.Uuid

  title       String
  status      MeetingStatus @default(scheduled)
  hostId      String        @map("host_id") @db.Uuid
  scheduledAt DateTime      @map("scheduled_at") @db.Timestamptz(3)

  host         User                 @relation("MeetingHost", fields: [hostId], references: [id], onDelete: Restrict)
  participants MeetingParticipant[]
  files        MeetingFile[]
  fileUploads  MeetingFileUpload[]

  @@index([hostId])
  @@map("meetings")
}

model MeetingParticipant {
  meetingId String @map("meeting_id") @db.Uuid
  userId    String @map("user_id") @db.Uuid

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([meetingId, userId])
  @@index([userId])
  @@map("meeting_participants")
}

enum MeetingFileStatus {
  uploaded
  processing
  ready
  failed
  deleted

  @@map("meeting_file_status")
}

/// A file attached to a meeting. Mirrors `MeetingFile` in @repo/shared plus the columns the
/// processing worker owns (`storageKey`, `checksum`, `attempts`, `leasedUntil`, `purgedAt`),
/// which never leave this layer.
model MeetingFile {
  id         String @id @default(uuid()) @db.Uuid
  meetingId  String @map("meeting_id") @db.Uuid
  uploaderId String @map("uploader_id") @db.Uuid

  /// The user's filename after trimming. Display only — the object lives at `storageKey`.
  name        String
  contentType String @map("content_type")
  /// Int, not BigInt: the cap is 100 MB. Past 2 GB this column changes in the same commit.
  size        Int
  /// `<meetingId>/<fileId>` under MEETING_FILES_DIR. Opaque, so a name can never be a path.
  storageKey  String @unique @map("storage_key")

  checksum     String?
  thumbnailKey String? @map("thumbnail_key")
  /// `<storageKey>.transcript.txt`, set by the transcription step. Null for every file
  /// uploaded while the flag was off, and for every type that is neither audio nor video.
  transcriptKey String? @map("transcript_key")

  status        MeetingFileStatus @default(uploaded)
  /// User-safe copy only; the real cause is logged, never stored.
  failureReason String?           @map("failure_reason")
  /// Claims, not failures: incremented every time a worker takes the row.
  attempts      Int               @default(0)
  leasedUntil   DateTime?         @map("leased_until") @db.Timestamptz(3)

  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  processedAt DateTime? @map("processed_at") @db.Timestamptz(3)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(3)
  /// Set once the worker has removed the bytes of a soft-deleted row, so the purge runs
  /// exactly once and a crash mid-unlink is retried rather than forgotten.
  purgedAt    DateTime? @map("purged_at") @db.Timestamptz(3)

  // Restrict on both: nothing deletes a meeting or a user from under a file without going
  // through the worker's soft-delete-then-purge path.
  meeting  Meeting @relation(fields: [meetingId], references: [id], onDelete: Restrict)
  uploader User    @relation(fields: [uploaderId], references: [id], onDelete: Restrict)

  @@index([meetingId, status])
  @@index([status, leasedUntil])
  @@map("meeting_files")
}

/// A chunked upload in progress: the bytes of a large file arriving one chunk at a time,
/// before any `MeetingFile` exists. Its own table precisely so that it is not one — no file
/// is listed, downloadable, or counted against the meeting's cap until `complete` assembles
/// the chunks and hands them to the single-request upload command.
///
/// Chunks live at `uploads/<id>/<index>` under MEETING_FILES_DIR and are removed by the
/// worker, which claims expired, unpurged rows the same way it claims a deleted file.
model MeetingFileUpload {
  id         String @id @default(uuid()) @db.Uuid
  meetingId  String @map("meeting_id") @db.Uuid
  uploaderId String @map("uploader_id") @db.Uuid

  /// The declared display name, already through `normaliseFileName`. The type is not declared
  /// at all: it is sniffed from the assembled bytes at completion, never taken from a client.
  name String
  /// Int, like `MeetingFile.size`, and capped at 1 GiB for the same reason.
  size Int

  chunkSize  Int @map("chunk_size")
  chunkCount Int @map("chunk_count")
  /// Indexes durably on disk. A resend of the same index leaves one entry, so this is a set
  /// the handler keeps sorted rather than an append log.
  receivedChunks Int[] @map("received_chunks")

  /// Claims, not failures, and the purge lease: the same pair `meeting_files` carries, so a
  /// worker that dies mid-removal leaves a row another worker reclaims when the lease lapses,
  /// and a removal that keeps throwing is given up on instead of retried for ever.
  attempts    Int       @default(0)
  leasedUntil DateTime? @map("leased_until") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  /// When the session stops accepting chunks. Aborting sets this to now(); the worker treats
  /// expired and aborted identically, which is why abort needs no status column.
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  /// Set once the chunk tree is gone, so the removal runs exactly once and a crash mid-removal
  /// is retried rather than forgotten.
  purgedAt  DateTime? @map("purged_at") @db.Timestamptz(3)

  // Restrict on both, as for a file: nothing deletes a meeting or a user out from under an
  // upload whose chunks are still on disk.
  meeting  Meeting @relation(fields: [meetingId], references: [id], onDelete: Restrict)
  uploader User    @relation(fields: [uploaderId], references: [id], onDelete: Restrict)

  @@index([meetingId])
  /// The uploader's foreign key, and the per-uploader cap's count of unpurged sessions.
  @@index([uploaderId, purgedAt])
  @@index([expiresAt, purgedAt])
  @@map("meeting_file_uploads")
}
