# Shared defaults for local development.
# Copy to .env and adjust. Per-app overrides live in apps/*/.env.example.
#
# PORT and WEB_PORT are preferences, not commitments: `pnpm dev` probes each one and moves up
# to the next free port when something else already holds it, rewriting NEXT_PUBLIC_API_URL to
# match. A deployment gets the port it is given — the search is development-only.

NODE_ENV=development

# docker-compose: host port published for the postgres service.
# Keep this in sync with the port in DATABASE_URL below.
POSTGRES_PORT=5433

# apps/api
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/video_meetings
PORT=3001

# Signs access tokens. Left empty on purpose: a placeholder here is a signing key published in
# this repository, and one long enough to pass validation is one the API would accept. Fill it
# in before the API will boot — `openssl rand -base64 32`, at least 32 characters.
JWT_SECRET=
JWT_EXPIRES_IN_SECONDS=3600

# Credential attempts one client address may spend per window on /api/auth — register, login,
# and the password change. /api/auth/me is exempt; page gating calls it constantly.
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
AUTH_RATE_LIMIT_ATTEMPTS=10
# Reverse proxies you control in front of the API — which address a request is counted as. 0
# trusts none and ignores X-Forwarded-For; behind a proxy that terminates TLS, set exactly how
# many there are. One too many lets a client choose its own address, and so its own budget.
TRUST_PROXY_HOPS=0
# Browser origins allowed to call the API, comma-separated: scheme, host and port, no path.
# Required when NODE_ENV=production. Empty in development means the web app on WEB_PORT below,
# at localhost and 127.0.0.1 — set it to reach the dev server from a phone on your network.
CORS_ORIGINS=

# apps/web
WEB_PORT=3000

# Left untouched by `pnpm dev` unless it is a local URL on the same port as PORT above — a
# value aimed at any other host or port is taken as deliberate.
NEXT_PUBLIC_API_URL=http://localhost:3001/api
