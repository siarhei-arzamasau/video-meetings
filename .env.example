# Shared defaults for local development.
# Copy to .env and adjust. Per-app overrides live in apps/*/.env.example.

NODE_ENV=development

# docker-compose: host port published for the postgres service.
# Keep this in sync with the port in DATABASE_URL below.
POSTGRES_PORT=5433

# apps/api
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/video_meetings
PORT=3001

# apps/web
NEXT_PUBLIC_API_URL=http://localhost:3001/api
